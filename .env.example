# Copier ce fichier en .env (jamais commité) et remplir les valeurs.

# Token utilisateur longue durée (60 jours) généré via l'Explorateur de l'API Graph
IG_ACCESS_TOKEN=
# ID du compte Instagram professionnel (affiché par probe_api.py si laissé vide)
IG_USER_ID=
# Version de l'API Graph (voir developers.facebook.com/docs/graph-api/changelog)
GRAPH_API_VERSION=v27.0

# Plus tard (phases 1+)
META_APP_ID=
META_APP_SECRET=
# Supabase → Project Settings → API Keys
SUPABASE_URL=
# Clé publique (sb_publishable_… ou ancienne clé « anon ») : la seule autorisée dans l'app Android
SUPABASE_PUBLISHABLE_KEY=
# Clé secrète (sb_secret_… ou ancienne « service_role ») : collecteur uniquement, contourne RLS
SUPABASE_SECRET_KEY=
